{
  "UUID": "com.narlei.claudeusage.plugin",
  "Name": "Claude Code Usage",
  "Description": "Monitor one or more Claude Code accounts in real time. Shows the 5-hour rolling limit and the weekly limit (all models) directly on your Ulanzi Deck button, with color-coded thresholds and reset countdown. Each button can target a different Claude Code config dir (CLAUDE_CONFIG_DIR) and carry a custom caption. Credentials are read securely from the macOS Keychain — no API key required.",
  "Author": "Narlei Moreira",
  "Version": "1.1.0",
  "Icon": "resources/icon.png",
  "Category": "Claude Code",
  "CategoryIcon": "resources/icon.png",
  "CodePath": "plugin/app.js",
  "Type": "JavaScript",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "Actions": [
    {
      "Name": "5-hour Limit",
      "Tooltip": "Claude Code 5-hour rolling limit usage.",
      "Icon": "resources/action-5h.png",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "com.narlei.claudeusage.plugin.fivehour",
      "States": [
        {
          "Image": "resources/action-5h.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Weekly Limit",
      "Tooltip": "Claude Code weekly (all models) usage.",
      "Icon": "resources/action-7d.png",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "com.narlei.claudeusage.plugin.weekly",
      "States": [
        {
          "Image": "resources/action-7d.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    }
  ],
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Software": {
    "MinVersion": "3.0.11"
  }
}
